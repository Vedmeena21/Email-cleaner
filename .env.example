# Copy to .env (never commit .env). See README.md for where each value comes from.

# --- Gmail (workspace-mcp) -------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Microsoft (softeria ms-365-mcp-server) --------------------------------
# Nothing secret needed: sign-in is a device code, tokens live in the macOS Keychain.

# --- IMAP accounts (mailcleaner server) ------------------------------------
# One app password per IMAP account in config/accounts.md.
# Name: MC_<ACCOUNT ID, upper-case, dashes as underscores>_APP_PASSWORD
# e.g. account id "yahoo-test" -> MC_YAHOO_TEST_APP_PASSWORD
MC_YAHOO_TEST_APP_PASSWORD=
